            ".write": "$player.matches(/^({{TURMA}})$/) && newData.exists() && (!data.exists() || (now - data.child('t').val() >= 2000 && newData.child('k').val() >= data.child('k').val() && newData.child('k').val() <= data.child('k').val() + 10)) && (data.exists() || newData.child('k').val() <= 10)",
            ".validate": "newData.hasChildren(['k', 't'])",
            "k": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && newData.val() % 1 === 0"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "juke": {
          ".write": "newData.exists() && (!data.exists() || now - data.child('t').val() >= 3000)",
          ".validate": "newData.hasChildren(['s', 'p', 't'])",
          "s": {
            ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 31 && newData.val() % 1 === 0"
          },
          "p": {
            ".validate": "newData.isString() && newData.val().matches(/^({{TURMA}})$/)"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        },
        "config": {
          "eventos": {
            ".write": "newData.exists() && newData.child('p').val() === '{{ADMIN}}'",
            ".validate": "newData.hasChildren(['mult', 'p', 't'])",
            "mult": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "p": {
              ".validate": "newData.isString()"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "forcar": {
              "$epoca": {
                ".validate": "$epoca.matches(/^[0-9]{1,9}$/) && newData.isString() && newData.val().matches(/^(ratazana|apagao|alien|dragao|dino)$/)"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "evento": {
          "$e": {
            ".write": "$e.matches(/^[0-9]{1,9}$/) && !newData.exists() && (!data.child('abertura').exists() || now - data.child('abertura').child('at').val() > 3600000)",
            "abertura": {
              ".write": "$e.matches(/^[0-9]{1,9}$/) && !data.exists() && newData.exists()",
              ".validate": "newData.hasChildren(['n', 'at'])",
              "n": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0"
              },
              "at": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            },
            "fim": {
              ".write": "$e.matches(/^[0-9]{1,9}$/) && !data.exists() && newData.exists() && data.parent().child('abertura').exists()",
              ".validate": "newData.hasChildren(['como', 'p', 'at'])",
              "como": {
                ".validate": "newData.isString() && newData.val().matches(/^(morto|religado)$/)"
              },
              "p": {
                ".validate": "newData.isString() && newData.val().matches(/^({{TURMA}})$/)"
              },
              "at": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            },
            "dano": {
              "$ent": {
                "$player": {
                  ".write": "$player.matches(/^({{TURMA}})$/) && $ent.matches(/^(rato|alien|grande|disco[0-5]|dragao|dino)$/) && newData.exists() && data.parent().parent().parent().child('abertura').exists() && (!data.exists() || newData.val() >= data.val())",
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "trofeus": {
          "$trofeu": {
            "$player": {
              ".write": "$player.matches(/^({{TURMA}})$/) && $trofeu.matches(/^(rabo|vela|gorjeta|antena|sumiuze|dente|ovo)$/) && !data.exists() && newData.exists()",
              ".validate": "newData.val() === now"
            }
          }
        },
        "inventario": {
          "$player": {
            "$item": {
              ".write": "$player.matches(/^({{TURMA}})$/) && $item.matches(/^(mc-camisa-verde|mc-calca-caqui|mc-cabelo-melado|mc-camisa-inseticida|mc-cabelo-asa|mc-camisa-rainha|mc-calca-enxame|mc-cabelo-coroa|qm-camisa-chita|qm-calca-remendo|qm-cabelo-milho|qm-camisa-bandeirinha|qm-calca-quadrilha|qm-cabelo-fogueira|mc-chapeu-bone|qm-chapeu-palha|qm-chapeu-cartola|ch-camisa-avental|ch-calca-carvao|ch-cabelo-fumaca|ch-camisa-samambaia|ch-calca-lava|ch-cabelo-brasa)$/) && !data.exists() && newData.exists()",
              ".validate": "newData.val() === now"
            }
          }
        },
        "po": {
          "$player": {
            ".write": "$player.matches(/^({{TURMA}})$/) && newData.exists() && (!data.exists() || (now - data.child('t').val() >= 500 && newData.child('g').val() >= data.child('g').val() && newData.child('s').val() >= data.child('s').val()))",
            ".validate": "newData.hasChildren(['g', 's', 't']) && newData.child('s').val() <= newData.child('g').val()",
            "g": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && newData.val() % 1 === 0"
            },
            "s": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000 && newData.val() % 1 === 0"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "portais": {
          "$portal": {
            "$player": {
              ".write": "$portal.matches(/^(moscas|quermesse|churrasco)$/) && $player.matches(/^({{TURMA}})$/) && newData.exists() && (!data.exists() || data.child('t').val() < (now - ((now - 32400000) % 86400000)) || (now - data.child('t').val() >= 2000 && newData.child('s').val() >= data.child('s').val()))",
              ".validate": "newData.hasChildren(['s', 'f', 'v', 't'])",
              "s": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && newData.val() % 1 === 0"
              },
              "f": {
                ".validate": "newData.isString() && newData.val().length <= 2400 && newData.val().length % 4 === 0 && newData.val().matches(/^[0-9a-z]*$/)"
              },
              "v": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99 && newData.val() % 1 === 0"
              },
              "t": {
                ".validate": "newData.val() === now"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    }
  }
}
